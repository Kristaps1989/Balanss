{
  "expo": {
    "name": "Balanss",
    "slug": "balanss",
    "version": "0.2.1",
    "scheme": "balanss",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#121513",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "lv.balanss.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSHealthShareUsageDescription": "Balanss nolasa soļus, pulsu un miegu, lai parādītu tavu dienu vienā skatā."
      }
    },
    "android": {
      "package": "lv.balanss.app",
      "adaptiveIcon": {
        "backgroundColor": "#D9693C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121513",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Balanss izmanto kameru, lai nofotografētu maltīti un atpazītu produktus.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Balanss piekļūst foto, lai tu varētu pievienot maltīti no galerijas.",
          "cameraPermission": "Balanss izmanto kameru, lai nofotografētu maltīti."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D9693C"
        }
      ],
      "expo-apple-authentication",
      "react-native-health-connect",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": null
      }
    }
  }
}
