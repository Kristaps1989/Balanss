# Copy to backend/.env for local development. Never commit real secrets.

# --- core
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://balanss:balanss@localhost:5432/balanss
# At least 32 random characters in production: openssl rand -base64 48
JWT_SECRET=
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WEB_URL=https://balanss.app
APP_SCHEME=balanss
# Comma list; "*" allows all (dev only). Native apps do not need CORS.
CORS_ORIGINS=*
LOG_LEVEL=debug

# --- auth providers
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_IDS=lv.balanss.app

# --- e-mail (console prints the link and returns devToken)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Balanss <noreply@balanss.app>

# --- AI (fake is used when no key is set)
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- storage, push, billing, scheduler
STORAGE_DIR=./storage
EXPO_ACCESS_TOKEN=
REVENUECAT_WEBHOOK_SECRET=
SCHEDULER=on
